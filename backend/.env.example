# Copy to backend/.env

# LLM: OpenRouter (https://openrouter.ai/settings/keys). Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5.5
# Cheaper model for the questions and self-checks
LLM_MODEL_FAST=anthropic/claude-haiku-5.5
# function_calling (default, widest support) | json_schema | json_mode
LLM_STRUCTURED_METHOD=function_calling

FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-32-random-bytes
DEMO_AUTH=true
# Single-user mode: requests without a token act as this user (leave empty for multi-user)
LOCAL_USER_EMAIL=
LOCAL_USER_NAME=Me
# Repository read by the spec agent for projects without a linked repo (absolute path)
LOCAL_REPO_PATH=

# GitHub OAuth App (https://github.com/settings/developers → New OAuth App)
# Authorization callback URL = GITHUB_REDIRECT_URI
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Jira / Confluence
# Cloud: JIRA_EMAIL + API token from https://id.atlassian.com/manage-profile/security/api-tokens
# Data Center: leave JIRA_EMAIL empty, JIRA_TOKEN = personal access token
JIRA_URL=https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=
# Cloud: https://your-company.atlassian.net/wiki
CONFLUENCE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=
